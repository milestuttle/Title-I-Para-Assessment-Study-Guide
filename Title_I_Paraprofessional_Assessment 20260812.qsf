dex":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"A student reads a word problem and immediately says, 'I don't know what to do.' What is the most...","TertiaryAttribute":null,"Payload":{"QuestionText":"A student reads a word problem and immediately says, 'I don't know what to do.' What is the most effective first step a paraeducator can suggest?\n","QuestionID":"QID16","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"A student reads a word problem and immediately says, 'I don't know what to do.' What is the most...","Choices":{"1":{"Display":"Look at the numbers and just multiply them together."},"2":{"Display":"Let's read it together and underline the question they are asking us to answer."},"3":{"Display":"Skip this problem and go to the next one."},"4":{"Display":"The answer is 14. Let's see if we can work backwards."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID16","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"A student solves 14 x 3 and writes down 312. Based on the answer, what underlying concept does th...","TertiaryAttribute":null,"Payload":{"QuestionText":"A student solves 14 x 3 and writes down 312. Based on the answer, what underlying concept does the student likely misunderstand?\n","QuestionID":"QID17","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"A student solves 14 x 3 and writes down 312. Based on the answer, what underlying concept does th...","Choices":{"1":{"Display":"Place value and regrouping (they multiplied 3x4=12 and 3x1=3, writing them side by side)."},"2":{"Display":"The multiplication table for 3s."},"3":{"Display":"How to carry a remainder in division."},"4":{"Display":"The commutative property of multiplication."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID17","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"You are helping a student understand how to add negative numbers, specifically -3 + 5. What is th...","TertiaryAttribute":null,"Payload":{"QuestionText":"You are helping a student understand how to add negative numbers, specifically -3 + 5. What is the best way to explain this visually?","QuestionID":"QID18","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"You are helping a student understand how to add negative numbers, specifically -3 + 5. What is th...","Choices":{"1":{"Display":"Draw a number line, start at -3, and move 5 spaces to the right."},"2":{"Display":"Tell them that two negatives make a positive."},"3":{"Display":"Draw 3 red dots and 5 blue dots and count them all together."},"4":{"Display":"Explain that they should just subtract 5 - 3 and ignore the negative sign."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID18","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"1","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"After explaining a difficult math concept to a student, what is the most reliable way to ensure t...","TertiaryAttribute":null,"Payload":{"QuestionText":"After explaining a difficult math concept to a student, what is the most reliable way to ensure they actually understand it before moving on?\n","QuestionID":"QID19","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"After explaining a difficult math concept to a student, what is the most reliable way to ensure t...","Choices":{"1":{"Display":"Ask them, 'Does that make sense?'"},"2":{"Display":"Have them copy down exactly what you wrote on the whiteboard."},"3":{"Display":"Ask the student to talk you through their steps as they solve the next problem on their own."},"4":{"Display":"Give them a high-five and move to the next student."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID19","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Simplify the following expression: 8 + (4 x 3) - 2","TertiaryAttribute":null,"Payload":{"QuestionText":"Simplify the following expression: 8 + (4 x 3) - 2","QuestionID":"QID2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"Simplify the following expression: 8 + (4 x 3) - 2","Choices":{"1":{"Display":"34"},"2":{"Display":"18"},"3":{"Display":"14"},"4":{"Display":"22"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID2","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"A student looks at a math worksheet, crosses their arms, and says, 'I'm just bad at math, I can't...","TertiaryAttribute":null,"Payload":{"QuestionText":"A student looks at a math worksheet, crosses their arms, and says, 'I'm just bad at math, I can't do this.' What is the most appropriate pedagogical response?\n","QuestionID":"QID20","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"A student looks at a math worksheet, crosses their arms, and says, 'I'm just bad at math, I can't...","Choices":{"1":{"Display":"That's okay, not everyone is a math person. Let's just try to get a few done."},"2":{"Display":"Let's cover up the rest of the page and just look at the very first step of problem number one together."},"3":{"Display":"If you don't do this, you will have to stay in during recess."},"4":{"Display":"I'll do the first five for you so you have less to do."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID20","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"A student asks, 'Why do I even need to learn how to find the perimeter of a shape?' Which real-wo...","TertiaryAttribute":null,"Payload":{"QuestionText":"A student asks, 'Why do I even need to learn how to find the perimeter of a shape?' Which real-world example best illustrates this concept?\n","QuestionID":"QID21","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"A student asks, 'Why do I even need to learn how to find the perimeter of a shape?' Which real-wo...","Choices":{"1":{"Display":"You need it to figure out how much paint you need to cover a wall."},"2":{"Display":"You need it to figure out how much water fills up a swimming pool."},"3":{"Display":"You need it to figure out how much fence you need to build around a garden."},"4":{"Display":"You need it to figure out how long a road trip will take."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID21","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID22","SecondaryAttribute":"Subject-Verb Agreement: Choose the sentence that is grammatically correct.","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Subject-Verb Agreement:<\/b> Choose the sentence that is grammatically correct.","QuestionID":"QID22","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"Subject-Verb Agreement: Choose the sentence that is grammatically correct.","Choices":{"1":{"Display":"The box of ornaments belong in the attic."},"2":{"Display":"Neither the teacher nor the students is ready for the assembly."},"3":{"Display":"All of the players is getting a trophy."},"4":{"Display":"The committee has decided to postpone the vote until next week."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID22","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"4","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID23","SecondaryAttribute":"Pronoun-Antecedent Agreement: Which sentence uses pronouns correctly?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Pronoun-Antecedent Agreement:<\/b> Which sentence uses pronouns correctly?","QuestionID":"QID23","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"Pronoun-Antecedent Agreement: Which sentence uses pronouns correctly?","Choices":{"1":{"Display":"If a students want to succeed, he should do his homework."},"2":{"Display":"Each of the girls brought her own lunch to the field trip."},"3":{"Display":"The company updated their policy on employee absences."},"4":{"Display":"Somebody left their backpack in the hallway."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID23","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID24","SecondaryAttribute":"Punctuation (Run-ons and Comma Splices): Identify the sentence with correct punctuation.","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Punctuation (Run-ons and Comma Splices): <\/b>Identify the sentence with correct punctuation.","QuestionID":"QID24","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"Punctuation (Run-ons and Comma Splices): Identify the sentence with correct punctuation.","Choices":{"1":{"Display":"The weather was freezing, however we decided to go hiking anyway."},"2":{"Display":"I love reading historical fiction it teaches me about the past."},"3":{"Display":"She finished her math assignment early; therefore, she had time to read a book."},"4":{"Display":"Because the bell rang. The students packed up their bags."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID24","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"3","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID25","SecondaryAttribute":"Punctuation (Apostrophes): Which sentence correctly uses apostrophes for possession and contraction?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Punctuation (Apostrophes): <\/b>Which sentence correctly uses apostrophes for possession and contraction?","QuestionID":"QID25","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"Punctuation (Apostrophes): Which sentence correctly uses apostrophes for possession and contraction?","Choices":{"1":{"Display":"Its a shame that the dog lost it's collar."},"2":{"Display":"The teachers lounge is located next to the principals office."},"3":{"Display":"They're going to park their car over there."},"4":{"Display":"The student's all passed the final exam."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID25","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"Capitalization: Identify the sentence with a capitalization error.","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Capitalization: <\/b>Identify the sentence with a capitalization error.","QuestionID":"QID26","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"Capitalization: Identify the sentence with a capitalization error.","Choices":{"1":{"Display":"We are studying the causes of the American Revolution."},"2":{"Display":"We drove North for the holidays."},"3":{"Display":"He grew up in Harlem, New York"},"4":{"Display":"The President of the United States gave a speech on television."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID26","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseT