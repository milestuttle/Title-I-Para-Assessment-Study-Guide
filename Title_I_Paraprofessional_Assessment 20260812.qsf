},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID51","SecondaryAttribute":"A student stops at a word they do not know and says, \"I give up.\" What is the best way to support...","TertiaryAttribute":null,"Payload":{"QuestionText":"A student stops at a word they do not know and says, \"I give up.\" What is the best way to support their <b>Self-Correction<\/b> skills?","QuestionID":"QID51","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"A student stops at a word they do not know and says, \"I give up.\" What is the best way to support...","Choices":{"1":{"Display":"Read the word for them so they do not lose confidence."},"2":{"Display":"Ask, \"What sound does the first letter make?\" and \"Does that word make sense in this sentence?\""},"3":{"Display":"Tell them to skip the paragraph."},"4":{"Display":"Send them to the teacher for help."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID51","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"You are helping a student with predicting. Which question should you ask before they start a new...","TertiaryAttribute":null,"Payload":{"QuestionText":"You are helping a student with <b>predicting<\/b>. Which question should you ask before they start a new chapter?","QuestionID":"QID52","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"You are helping a student with predicting. Which question should you ask before they start a new...","Choices":{"1":{"Display":"Who was the author of this book?"},"2":{"Display":"B