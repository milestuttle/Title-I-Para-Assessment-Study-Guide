"TR_bEi1wCdTLMQ7PPU","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"TriggerAction":"EmailMessage","Type":"OnQuestionResponse","ToEmail":"miles.tuttle@canoncityschools.org","FromName":"","FromEmail":"trigger@qemailserver.com","SendDate":"now","Subject":"Title I Paraprofessional Assessment Complete","Message":"<p data-pm-slice=\"1 1 []\">Thank you for completing the Title I Paraprofessional Assessment. We are pleased to inform you that you passed with a score of <strong>${gr:\/\/SC_4I7dsxjXjX6QtaC\/Score}<\/strong>!<\/p>\n\n<p>Successfully completing this assessment fulfills the Colorado Department of Education&#39;s &quot;Highly Qualified&quot; requirement for your role. Our Human Resources department has received a copy of your results for your personnel file.<\/p>\n\n<p>If you have any questions or need to complete further onboarding paperwork, HR will be in touch with you shortly.<\/p>\n","IncludeReport":true,"UseFullText":false,"Logic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"${gr:\/\/SC_4I7dsxjXjX6QtaC\/Score}","Operator":"GreaterThanOrEqual","RightOperand":"48","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">${gr:\/\/SC_4I7dsxjXjX6QtaC\/Score}<\/span> <span class=\"OpDesc\">Is Greater Than or Equal to<\/span> <span class=\"RightOpDesc\"> 48 <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"ID":"TR_bEi1wCdTLMQ7PPU"}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"TR","PrimaryAttribute":"TR_bxdEu6RkuNKAJwi","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"TriggerAction":"EmailMessage","Type":"OnQuestionResponse","ToEmail":"miles.tuttle@canoncityschools.org","FromName":"","FromEmail":"trigger@qemailserver.com","SendDate":"now","Subject":"Title I Paraprofessional Assessment Complete","Message":"<p data-pm-slice=\"1 1 []\">Thank you for your time in completing the Title I Paraprofessional Assessment.<\/p>\n\n<p>Your final score was <strong>${gr:\/\/SC_4I7dsxjXjX6QtaC\/Score}<\/strong>. The Colorado Department of Education requires a score of 70% or higher to meet the &quot;Highly Qualified&quot; standard for this position.<\/p>\n\n<p>Please don&#39;t be discouraged! You are welcome to review the material and retake the assessment. We want to ensure you have all the tools and knowledge you need to feel confident in the classroom.<\/p>\n\n<p>Please contact [HR Contact Name\/Email] to discuss scheduling a retake or to get recommendations for study resources.<\/p>\n","IncludeReport":true,"UseFullText":false,"Logic":{"0":{"0":{"LogicType":"EmbeddedField","LeftOperand":"${gr:\/\/SC_4I7dsxjXjX6QtaC\/Score}","Operator":"LessThan","RightOperand":"47","_HiddenExpression":false,"Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">${gr:\/\/SC_4I7dsxjXjX6QtaC\/Score}<\/span> <span class=\"OpDesc\">Is Less Than<\/span> <span class=\"RightOpDesc\"> 47 <\/span>"},"Type":"If"},"Type":"BooleanExpression"},"ID":"TR_bxdEu6RkuNKAJwi"}}]}