:[],"DataExportTag":"QID28","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"Modifiers: Which sentence contains a misplaced or dangling modifier?","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Modifiers: <\/b>Which sentence contains a misplaced or dangling modifier?","QuestionID":"QID29","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"Modifiers: Which sentence contains a misplaced or dangling modifier?","Choices":{"1":{"Display":"Barking loudly, the dog chased the mail carrier down the street."},"2":{"Display":"Hoping to excuse the absence, the note was written and signed by his mother."},"3":{"Display":"The student quickly finished her lunch before the bell rang."},"4":{"Display":"Exhausted from the trip, she fell asleep on the couch."}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":[],"DataExportTag":"QID29","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4I7dsxjXjX6QtaC":"1"},"index":0}],"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_9nlqAiEPS5QQ7eC","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Add the following fractions and simplify: 1\/3 + 2\/5","TertiaryAttribute":null,"Payload":{"QuestionText":"Add the following fractions and simplify: 1\/3 + 2\/5\n","QuestionID":"QID3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","QuestionDescription":"Add the following fractions and simplify: 1\/3 + 2\/5","Choices":{"1":{"Display":"3\/8"},"2":{"Display":"3\/15"},"3":{"Display":"11\/15"},"4":{"Display":"3\/15"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"Type":"None"}},"Language":